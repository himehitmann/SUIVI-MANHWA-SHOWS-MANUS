{
  "manifest_version": 3,
  "name": "Dasi — Continue Reading & Watching",
  "version": "0.3.0",
  "description": "Remember where you stopped in any manga, webtoon, anime or series. Local-first, private by design.",
  "action": { "default_title": "Open Dasi", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "notifications", "alarms"],
  "host_permissions": ["https://translate.googleapis.com/*", "https://api.mymemory.translated.net/*"],
  "commands": {
    "save-progress": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+S" },
      "description": "Save progress on the current page"
    }
  },
  "icons": { "128": "icon.png" }
}
