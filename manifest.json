{
  "manifest_version": 3,
  "name": "Yomu — Continue Reading & Watching",
  "version": "0.4.4",
  "description": "Track and resume any manga, webtoon, anime, series, film or game — with one-click page translation.",
  "action": {
    "default_title": "Open Yomu",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://graphql.anilist.co/*",
    "https://openlibrary.org/*",
    "https://store.steampowered.com/*",
    "https://cdn.cloudflare.steamstatic.com/*",
    "https://api.tvmaze.com/*",
    "https://api.ocr.space/*",
    "https://en.wikipedia.org/*",
    "https://fr.wikipedia.org/*",
    "https://es.wikipedia.org/*",
    "https://de.wikipedia.org/*",
    "https://ja.wikipedia.org/*",
    "https://ko.wikipedia.org/*",
    "https://pt.wikipedia.org/*",
    "https://zh.wikipedia.org/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "save-progress": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Save progress on the current page"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "116"
}
