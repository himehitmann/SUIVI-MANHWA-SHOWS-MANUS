# Web app (build-time). Leave unset to keep Dasi fully local (default).
# Set to your deployed sync API to enable accounts + cross-device sync.
VITE_SYNC_API_URL=

# Sync backend (server/). Required only if you run the sync API.
SYNC_JWT_SECRET=
# Optional JSON file for dev/self-host persistence (use Postgres in production).
SYNC_DB_FILE=./.data/dasi-sync.json
PORT=3000

# Exact allowed browser origins, comma-separated (web URL and installed extension origin).
ALLOWED_ORIGINS=
# Set only when deployed behind this many trusted reverse proxies.
TRUST_PROXY_HOPS=

# Optional billing. Keep empty until provider test-mode lifecycle is verified.
# Secrets belong only on the server, never in VITE_* variables or the extension.
STRIPE_WEBHOOK_SECRET=
# Required to retrieve missing line items for configured one-time purchases.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_LIFETIME=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_LIFETIME=
