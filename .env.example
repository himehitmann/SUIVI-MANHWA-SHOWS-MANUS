# Web app (build-time). Leave unset to keep Dasi fully local (default).
# Set to your deployed sync API to enable accounts + cross-device sync.
VITE_SYNC_API_URL=

# Sync backend (server/). Required only if you run the sync API.
SYNC_JWT_SECRET=change-me-to-a-long-random-string
# Optional JSON file for dev/self-host persistence (use Postgres in production).
SYNC_DB_FILE=./.data/dasi-sync.json
PORT=3000
